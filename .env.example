# ==============================================================================
# Legal Practice Management Platform — Environment Configuration Template
# ==============================================================================
# NOTE: In production (NODE_ENV=production), startup will fail fast if any
# required variable is missing or left empty. Configure real values in your .env.

NODE_ENV=production
PORT=9000

# Client Application URL (Strictly enforced for CORS and redirection)
CLIENT_URL=https://your-chambers-domain.com
APP_URL=https://your-chambers-domain.com

# ==============================================================================
# Database Configuration (MySQL 8.0+)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=legal_practice
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ==============================================================================
# Authentication & JWT Secrets (REQUIRED - Generate 64+ char random keys)
# ==============================================================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# Central SMTP Email Service (REQUIRED for OTP, 2FA, & Notices)
# ==============================================================================
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=Chambers Legal Practice
EMAIL_REPLY_TO=

# OTP & Password Security Limits
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=5
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_MAX_RETRIES=3
EMAIL_RATE_LIMIT_PER_HOUR=5

# ==============================================================================
# Document Management & Storage
# ==============================================================================
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./private-storage/documents
DOCUMENT_MAX_FILE_SIZE_MB=25
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,text/plain,image/jpeg,image/png
DOCUMENT_EXTERNAL_LINKS_ENABLED=true
DOCUMENT_EXTERNAL_LINK_HTTPS_ONLY=true
DOCUMENT_RETENTION_ENABLED=false

# ==============================================================================
# E-Signature Integration (Digio / Leegality ASP)
# ==============================================================================
ESIGN_PROVIDER=
ESIGN_CLIENT_ID=
ESIGN_CLIENT_SECRET=
ESIGN_WEBHOOK_SECRET=

# ==============================================================================
# Payment Gateways (Razorpay / PayU India)
# ==============================================================================
RAZORPAY_MODE=LIVE
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PAYU_MODE=LIVE
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
PAYU_MERCHANT_ID=
PAYU_WEBHOOK_SECRET=

# ==============================================================================
# AiSensy WhatsApp API Configuration
# ==============================================================================
AISENSY_ENABLED=false
AISENSY_API_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=
AISENSY_TEST_MODE=true
AISENSY_TEST_DESTINATION=
AISENSY_TIMEOUT_MS=15000
AISENSY_MAX_RETRIES=3
APP_TIMEZONE=Asia/Kolkata
RUN_REAL_AISENSY_TESTS=false

