{
  "name": "legal-practice-management",
  "version": "1.0.0",
  "private": true,
  "description": "Production-ready Legal Practice Management Platform for a private advocate's chambers in India",
  "scripts": {
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "test": "node tests/integration/aisensy/run_all_tests.js",
    "test:unit": "node tests/integration/aisensy/aisensy.service.test.js",
    "test:integration": "node tests/integration/aisensy/run_all_tests.js",
    "test:aisensy": "node scripts/test-aisensy-real.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
